{
  "name": "zuix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "tokens": "node tokens/src/build.mjs && node tokens/src/validate.mjs",
    "icons": "node zicon/scripts/build.mjs && node zicon/scripts/sprite.mjs",
    "icons:own": "node zicon/scripts/own.mjs",
    "style-audit": "node tools/audit.mjs",
    "manifest": "node tools/manifest.mjs",
    "typecheck": "pnpm -r typecheck",
    "test:browser": "node tests/browser/run.mjs",
    "barrels": "node tools/check-barrels.mjs",
    "docs:coverage": "node tools/docs-coverage.mjs",
    "llms": "pnpm --filter @zuccadev-labs/zuix-zudocs llms",
    "check": "pnpm tokens && pnpm icons && pnpm style-audit && pnpm manifest && pnpm barrels && pnpm html && pnpm docs:coverage && pnpm dist && pnpm matrix && pnpm llms && pnpm typecheck",
    "html": "node tools/html.mjs",
    "dist": "node tools/dist.mjs && node examples/html/build.mjs",
    "matrix": "node tools/compat-matrix.mjs",
    "test:html": "node tests/html/run.mjs",
    "test:browser:all": "BROWSER=all node tests/browser/run.mjs",
    "test:html:all": "BROWSER=all node tests/html/run.mjs",
    "build": "node tools/build.mjs",
    "test:pack": "node tools/pack-test.mjs",
    "test:pack:next": "node tools/pack-test.mjs --next",
    "test:blur": "node tests/blur-firefox.mjs",
    "bump": "node tools/version.mjs",
    "lint": "biome lint --error-on-warnings && node tools/use-client.mjs",
    "format": "biome format --write",
    "format:check": "biome format",
    "test:unit": "node tests/unit/run.mjs",
    "test:site": "node tests/site/run.mjs",
    "test:site:all": "BROWSER=all node tests/site/run.mjs",
    "audit:visual": "node tools/visual-audit.mjs",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test:unit && pnpm --filter @zuccadev-labs/zuix-zudocs build && pnpm test:site && pnpm build && pnpm test:pack --skip-build && pnpm test:html && pnpm test:browser"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "axe-core": "^4.14.1",
    "canvaskit-wasm": "0.42.0",
    "esbuild": "^0.28.2",
    "fast-check": "4.10.2",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "web-features": "^3.47.0"
  },
  "license": "MIT"
}
