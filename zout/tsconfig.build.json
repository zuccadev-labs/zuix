{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/esm",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "paths": {
      "@zuccadev-labs/zuix-zicon": ["../zicon/dist/esm/index.d.ts"],
      "@zuccadev-labs/zuix-zicon/icons/*": ["../zicon/dist/esm/icons/*.d.ts"],
      "@zuccadev-labs/zuix-zicon/*": ["../zicon/dist/esm/*.d.ts"],
      "@zuccadev-labs/zuix-zui": ["../zui/dist/esm/index.d.ts"],
      "@zuccadev-labs/zuix-zui/dom": ["../zui/dist/esm/dom/index.d.ts"]
    }
  },
  "include": ["src"]
}
