     "title": "Aplicación con rail, sidebar e inspector",
     "code": "<Shell\n  rail={<Rail><RailItem icon=\"home\" label=\"Home\" active /><RailItem icon=\"gear\" label=\"Settings\" /></Rail>}\n  sidebar={{ label: \"Navigation\", open: sidebarOpen, content: <Sidebar><SidebarSection title=\"Projects\" count={3}>…</SidebarSection></Sidebar> }}\n  inspector={{ label: \"Details\", open: detailsOpen, content: <SidePanel title=\"Details\">…</SidePanel> }}\n  onCloseOverlay={closePanels}\n>\n  <Page header={<PageHeader title=\"Overview\" />}>…</Page>\n</Shell>"
    }
