{
  "name": "@zuccadev-labs/zuix-zout",
  "version": "0.4.0",
  "type": "module",
  "description": "Layouts y ventanas dinámicas de la suite zuix.",
  "license": "MIT",
  "keywords": [
    "zuix",
    "layout",
    "app-shell",
    "split-pane",
    "sidebar",
    "tabs",
    "react",
    "html",
    "css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuccadev-labs/zuix.git",
    "directory": "zout"
  },
  "homepage": "https://github.com/zuccadev-labs/zuix/tree/main/zout#readme",
  "bugs": {
    "url": "https://github.com/zuccadev-labs/zuix/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./styles.compat.css": "./dist/zout.compat.css",
    "./manifest.json": "./manifest.json",
    "./html.json": "./html.json",
    "./dom": "./src/dom/index.ts",
    "./dist/zout.css": "./dist/zout.css",
    "./dist/zout.compat.css": "./dist/zout.compat.css",
    "./dist/zout.dom.js": "./dist/zout.dom.js",
    "./locales/en": "./src/locales/en.ts",
    "./locales/es": "./src/locales/es.ts",
    "./locales/pt": "./src/locales/pt.ts",
    "./locales/fr": "./src/locales/fr.ts",
    "./locales/de": "./src/locales/de.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@zuccadev-labs/zuix-zicon": "workspace:^",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@zuccadev-labs/zuix-tokens": "workspace:^",
    "@zuccadev-labs/zuix-zui": "workspace:^"
  },
  "devDependencies": {
    "@zuccadev-labs/zuix-zicon": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "manifest.json",
    "html.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/dom/*.ts",
    "./dist/esm/dom/*.js",
    "./dist/zout.dom.js"
  ],
  "publishConfig": {
    "main": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "./dom": {
        "types": "./dist/esm/dom/index.d.ts",
        "default": "./dist/esm/dom/index.js"
      },
      "./styles.css": "./dist/zout.css",
      "./styles.compat.css": "./dist/zout.compat.css",
      "./manifest.json": "./manifest.json",
      "./html.json": "./html.json",
      "./dist/zout.css": "./dist/zout.css",
      "./dist/zout.compat.css": "./dist/zout.compat.css",
      "./dist/zout.dom.js": {
        "types": "./dist/esm/dom/index.d.ts",
        "default": "./dist/zout.dom.js"
      },
      "./locales/en": {
        "types": "./dist/esm/locales/en.d.ts",
        "default": "./dist/esm/locales/en.js"
      },
      "./locales/es": {
        "types": "./dist/esm/locales/es.d.ts",
        "default": "./dist/esm/locales/es.js"
      },
      "./locales/pt": {
        "types": "./dist/esm/locales/pt.d.ts",
        "default": "./dist/esm/locales/pt.js"
      },
      "./locales/fr": {
        "types": "./dist/esm/locales/fr.d.ts",
        "default": "./dist/esm/locales/fr.js"
      },
      "./locales/de": {
        "types": "./dist/esm/locales/de.d.ts",
        "default": "./dist/esm/locales/de.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  }
}
