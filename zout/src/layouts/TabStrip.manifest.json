{
  "name": "TabStrip",
  "group": "layout",
  "description": "Tira de pestañas de trabajo con cierre y alta.",
  "import": "import { TabStrip } from \"@zuccadev-labs/zuix-zout\"",
  "exports": [
    "TabStrip"
  ],
  "props": [
    {
      "name": "tabs",
      "type": "WorkTab[]",
      "required": true,
      "description": "{ id, title, leading?, closable? }"
    },
    {
      "name": "activeId",
      "type": "string",
      "required": true
    },
    {
      "name": "onSelect",
      "type": "(id: string) => void",
      "required": true
    },
    {
      "name": "onClose",
      "type": "(id: string) => void"
    },
    {
      "name": "onAdd",
      "type": "() => void"
    },
    {
      "name": "closeLabel",
      "type": "string",
      "default": "Close tab"
    },
    {
      "name": "addLabel",
      "type": "string",
      "default": "New tab"
    }
  ],
  "tokens": [
    "row-hover",
    "surface-2",
    "surface-3",
    "glass-highlight",
    "fg",
    "fg-muted",
    "radius-full",
    "focus-ring"
  ],
  "classes": [
    "z-tabstrip"
  ],
  "a11y": "role=tablist; flechas, Inicio y Fin cambian de pestaña. La pestaña activa se desplaza sola a la vista cuando la tira no cabe.",
  "examples": [
    {
      "title": "Pestañas con alta",
      "code": "<TabStrip tabs={[{ id: \"a\", title: \"main.ts\" }, { id: \"b\", title: \"README.md\" }]} activeId={active} onSelect={setActive} onClose={closeTab} onAdd={newTab} />"
    }
  ],
  "behavior": "dom",
  "html": [
    {
      "title": "Pestañas con cierre y alta",
      "code": "<div class=\"z-tabstrip\" id=\"tabs-demo\">\n  <div class=\"z-tabstrip__list\" role=\"tablist\" aria-label=\"Open files\">\n    <div class=\"z-tabstrip__tab\" role=\"presentation\" data-selected=\"true\">\n      <button type=\"button\" role=\"tab\" class=\"z-tabstrip__select\" aria-selected=\"true\" tabindex=\"0\" data-tab-id=\"main\">\n        <span class=\"z-tabstrip__title\">main.ts</span>\n      </button>\n    </div>\n    <div class=\"z-tabstrip__tab\" role=\"presentation\">\n      <button type=\"button\" role=\"tab\" class=\"z-tabstrip__select\" aria-selected=\"false\" tabindex=\"-1\" data-tab-id=\"readme\">\n        <span class=\"z-tabstrip__title\">README.md</span>\n      </button>\n      <button type=\"button\" class=\"z-tabstrip__close\" title=\"Close tab\" aria-hidden=\"true\" tabindex=\"-1\">\n        <z-icon name=\"x-mark\" size=\"12\"></z-icon>\n      </button>\n    </div>\n    <div class=\"z-tabstrip__tab\" role=\"presentation\">\n      <button type=\"button\" role=\"tab\" class=\"z-tabstrip__select\" aria-selected=\"false\" tabindex=\"-1\" data-tab-id=\"config\">\n        <span class=\"z-tabstrip__title\">package.json</span>\n      </button>\n      <button type=\"button\" class=\"z-tabstrip__close\" title=\"Close tab\" aria-hidden=\"true\" tabindex=\"-1\">\n        <z-icon name=\"x-mark\" size=\"12\"></z-icon>\n      </button>\n    </div>\n  </div>\n  <button type=\"button\" class=\"z-tabstrip__add\" aria-label=\"New tab\" data-new-title=\"Untitled\">\n    <z-icon name=\"plus\" size=\"14\"></z-icon>\n  </button>\n</div>"
    }
  ],
  "origin": "`tabstrip` de zutool."
}
