{
  "name": "Rail",
  "group": "layout",
  "description": "Barra estrecha de navegación principal, solo iconos.",
  "import": "import { Rail, RailItem } from \"@zuccadev-labs/zuix-zout\"",
  "exports": ["Rail", "RailItem"],
  "props": [
    {
      "name": "brand",
      "type": "ReactNode"
    },
    {
      "name": "footer",
      "type": "ReactNode"
    },
    {
      "name": "label",
      "type": "string",
      "default": "Primary"
    },
    {
      "name": "RailItem.icon",
      "type": "IconName",
      "required": true
    },
    {
      "name": "RailItem.label",
      "type": "string",
      "required": true,
      "description": "Nombre accesible y título."
    },
    {
      "name": "RailItem.active",
      "type": "boolean"
    },
    {
      "name": "RailItem.badge",
      "type": "number | string"
    }
  ],
  "tokens": [
    "rail-width",
    "radius-full",
    "accent-solid",
    "fg-on-accent",
    "fg-muted",
    "accent-ring",
    "control-radius-lg",
    "danger-solid",
    "duration-fast",
    "duration-press",
    "ease-out",
    "ease-standard",
    "fg",
    "focus-offset",
    "focus-width",
    "panel-radius",
    "shadow-md",
    "space-1",
    "space-2",
    "space-3",
    "surface-2",
    "surface-solid",
    "text-fine",
    "weight-bold"
  ],
  "classes": ["z-rail"],
  "a11y": "<nav> con nombre (región navigation). Cada elemento es un botón de 40 × 40 px con aria-label; el activo lleva aria-current=page y el contador forma parte del nombre accesible.",
  "examples": [
    {
      "title": "Rail con pie",
      "code": "<Rail brand={<Logo />} footer={<RailItem icon=\"gear\" label=\"Settings\" />}>\n  <RailItem icon=\"home\" label=\"Home\" active />\n  <RailItem icon=\"bell\" label=\"Notifications\" badge={3} />\n</Rail>"
    }
  ],
  "origin": "Rail de zutool."
}
