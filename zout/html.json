     "html": "<div style=\"display:flex;gap:24px;align-items:center\">\n  <span class=\"z-float\" data-placement=\"top-end\">\n    <button type=\"button\" title=\"Notifications, 3 unread\" aria-label=\"Notifications, 3 unread\" class=\"z-btn z-btn--icon z-btn--secondary\" data-size=\"md\">\n      <z-icon name=\"bell\" size=\"16\"></z-icon>\n    </button>\n    <span class=\"z-float__item\">\n      <span class=\"z-badge\" data-tone=\"danger\" data-variant=\"solid\" data-size=\"sm\">3</span>\n    </span>\n  </span>\n  <span class=\"z-float\" data-placement=\"bottom-end\" style=\"--z-float-offset:14%\">\n    <span class=\"z-avatar\" data-size=\"md\" data-shape=\"circle\" role=\"img\" aria-label=\"Ana Ruiz\">\n      <span class=\"z-avatar__initials\" aria-hidden=\"true\">AR</span>\n    </span>\n    <span class=\"z-float__item\">\n      <span class=\"z-badge\" data-tone=\"success\" data-variant=\"solid\" data-size=\"sm\">On</span>\n    </span>\n  </span>\n  <span class=\"z-float\" data-placement=\"top-start\">\n    <button type=\"button\" class=\"z-btn z-btn--secondary\" data-size=\"md\">Reports</button>\n    <span class=\"z-float__item\">\n      <span class=\"z-badge\" data-tone=\"accent\" data-variant=\"solid\" data-size=\"sm\">New</span>\n    </span>\n  </span>\n</div>",
