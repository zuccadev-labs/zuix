   "examples": [
    {
     "title": "Pestañas con cierre y alta",
     "html": "<div class=\"z-tabstrip\" id=\"tabs-demo\">\n  <div class=\"z-tabstrip__list\" role=\"tablist\" aria-label=\"Open files\">\n    <div class=\"z-tabstrip__tab\" role=\"presentation\" data-selected=\"true\">\n      <button type=\"button\" role=\"tab\" class=\"z-tabstrip__select\" aria-selected=\"true\" tabindex=\"0\" data-tab-id=\"main\">\n        <span class=\"z-tabstrip__title\">main.ts</span>\n      </button>\n    </div>\n    <div class=\"z-tabstrip__tab\" role=\"presentation\">\n      <button type=\"button\" role=\"tab\" class=\"z-tabstrip__select\" aria-selected=\"false\" tabindex=\"-1\" data-tab-id=\"readme\">\n        <span class=\"z-tabstrip__title\">README.md</span>\n      </button>\n      <button type=\"button\" class=\"z-tabstrip__close\" title=\"Close tab\" aria-hidden=\"true\" tabindex=\"-1\">\n        <z-icon name=\"x-mark\" size=\"12\"></z-icon>\n      </button>\n    </div>\n    <div class=\"z-tabstrip__tab\" role=\"presentation\">\n      <button type=\"button\" role=\"tab\" class=\"z-tabstrip__select\" aria-selected=\"false\" tabindex=\"-1\" data-tab-id=\"config\">\n        <span class=\"z-tabstrip__title\">package.json</span>\n      </button>\n      <button type=\"button\" class=\"z-tabstrip__close\" title=\"Close tab\" aria-hidden=\"true\" tabindex=\"-1\">\n        <z-icon name=\"x-mark\" size=\"12\"></z-icon>\n      </button>\n    </div>\n  </div>\n  <button type=\"button\" class=\"z-tabstrip__add\" aria-label=\"New tab\" data-new-title=\"Untitled\">\n    <z-icon name=\"plus\" size=\"14\"></z-icon>\n  </button>\n</div>",
     "source": "manual"
    },
    {
     "title": "Grupos, indicadores y reordenación",
     "html": "<div class=\"z-tabstrip\" id=\"tabs-groups\" data-reorderable=\"\">\n  <div class=\"z-tabstrip__list\" role=\"tablist\" aria-label=\"Open files\">\n    <div class=\"z-tabstrip__group\" role=\"presentation\" data-group-id=\"ui\" data-tone=\"info\">\n      <button type=\"button\" class=\"z-tabstrip__chip\" aria-hidden=\"true\" tabindex=\"-1\" aria-expanded=\"true\" title=\"UI\">UI</button>\n    </div>\n    <div class=\"z-tabstrip__tab\" role=\"presentation\" data-selected=\"true\" data-group=\"ui\" data-tone=\"info\">\n      <button type=\"button\" role=\"tab\" class=\"z-tabstrip__select\" aria-selected=\"true\" aria-describedby=\"tabs-groups-ui\" aria-keyshortcuts=\"Delete Control+Shift+ArrowLeft Control+Shift+ArrowRight\" tabindex=\"0\" data-tab-id=\"button\">\n        <span class=\"z-tabstrip__title\">Button.tsx</span>\n        <span class=\"z-tabstrip__mark\" data-mark=\"modified\">\n          <span class=\"z-sr-only\">, modified</span>\n        </span>\n      </button>\n      <button type=\"button\" class=\"z-tabstrip__close\" title=\"Close tab\" aria-hidden=\"true\" tabindex=\"-1\">\n        <z-icon name=\"x-mark\" size=\"12\"></z-icon>\n      </button>\n    </div>\n    <div class=\"z-tabstrip__tab\" role=\"presentation\" data-group=\"ui\" data-tone=\"info\">\n      <button type=\"button\" role=\"tab\" class=\"z-tabstrip__select\" aria-selected=\"false\" aria-describedby=\"tabs-groups-ui\" aria-keyshortcuts=\"Delete Control+Shift+ArrowLeft Control+Shift+ArrowRight\" tabindex=\"-1\" data-tab-id=\"menu\">\n        <span class=\"z-tabstrip__title\">Menu.tsx</span>\n      </button>\n      <button type=\"button\" class=\"z-tabstrip__close\" title=\"Close tab\" aria-hidden=\"true\" tabindex=\"-1\">\n        <z-icon name=\"x-mark\" size=\"12\"></z-icon>\n      </button>\n    </div>\n    <div class=\"z-tabstrip__group\" role=\"presentation\" data-group-id=\"api\" data-tone=\"success\">\n      <button type=\"button\" class=\"z-tabstrip__chip\" aria-hidden=\"true\" tabindex=\"-1\" aria-expanded=\"true\" title=\"API\">API</button>\n    </div>\n    <div class=\"z-tabstrip__tab\" role=\"presentation\" data-group=\"api\" data-tone=\"success\">\n      <button type=\"button\" role=\"tab\" class=\"z-tabstrip__select\" aria-selected=\"false\" aria-describedby=\"tabs-groups-api\" aria-keyshortcuts=\"Delete Control+Shift+ArrowLeft Control+Shift+ArrowRight\" aria-busy=\"true\" tabindex=\"-1\" data-tab-id=\"routes\">\n        <span class=\"z-tabstrip__title\">routes.ts</span>\n        <span class=\"z-tabstrip__mark\" data-mark=\"busy\">\n          <span class=\"z-sr-only\">, busy</span>\n        </span>\n      </button>\n      <button type=\"button\" class=\"z-tabstrip__close\" title=\"Close tab\" aria-hidden=\"true\" tabindex=\"-1\">\n        <z-icon name=\"x-mark\" size=\"12\"></z-icon>\n      </button>\n    </div>\n    <div class=\"z-tabstrip__tab\" role=\"presentation\">\n      <button type=\"button\" role=\"tab\" class=\"z-tabstrip__select\" aria-selected=\"false\" aria-keyshortcuts=\"Delete Control+Shift+ArrowLeft Control+Shift+ArrowRight\" tabindex=\"-1\" data-tab-id=\"readme\">\n        <span class=\"z-tabstrip__title\">README.md</span>\n      </button>\n      <button type=\"button\" class=\"z-tabstrip__close\" title=\"Close tab\" aria-hidden=\"true\" tabindex=\"-1\">\n        <z-icon name=\"x-mark\" size=\"12\"></z-icon>\n      </button>\n    </div>\n  </div>\n  <span id=\"tabs-groups-ui\" hidden=\"\">UI</span>\n  <span id=\"tabs-groups-api\" hidden=\"\">API</span>\n  <span class=\"z-tabstrip__status z-sr-only\" role=\"status\"></span>\n</div>",
     "source": "manual"
    }
   ]
