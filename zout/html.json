   "behavior": "dom",
   "examples": [
    {
     "title": "Shell con barra de título, rail, sidebar redimensionable e inspector",
     "html": "<div style=\"width:100%;height:360px\">\n  <div class=\"z-shell z-canvas z-root\" id=\"shell-demo\">\n    <a class=\"z-shell__skip\" href=\"#shell-demo-main\">Skip to content</a>\n    <header class=\"z-titlebar\">\n      <div class=\"z-titlebar__brand\">\n        <button type=\"button\" title=\"Toggle navigation\" aria-label=\"Toggle navigation\" class=\"z-btn z-btn--icon z-btn--ghost\" data-size=\"sm\" data-z-shell-toggle=\"sidebar\">\n          <z-icon name=\"bars-3\" size=\"16\"></z-icon>\n        </button>\n      </div>\n      <div class=\"z-titlebar__center\"></div>\n      <div class=\"z-titlebar__actions\">\n        <button type=\"button\" title=\"Toggle details panel\" aria-label=\"Toggle details panel\" class=\"z-btn z-btn--icon z-btn--ghost\" data-size=\"sm\" data-z-shell-toggle=\"inspector\">\n          <z-icon name=\"adjustments-horizontal\" size=\"16\"></z-icon>\n        </button>\n      </div>\n    </header>\n    <div class=\"z-shell__body\">\n      <div class=\"z-shell__rail\">\n        <nav class=\"z-rail z-liquid\" aria-label=\"Primary\">\n          <div class=\"z-rail__items\">\n            <button type=\"button\" class=\"z-rail__item\" aria-label=\"Home\" title=\"Home\" aria-current=\"page\">\n              <z-icon name=\"home\" variant=\"solid\" size=\"20\"></z-icon>\n            </button>\n            <button type=\"button\" class=\"z-rail__item\" aria-label=\"Settings\" title=\"Settings\">\n              <z-icon name=\"gear\" size=\"20\"></z-icon>\n            </button>\n          </div>\n        </nav>\n      </div>\n      <aside class=\"z-liquid z-shell__side\" aria-label=\"Navigation\" data-side=\"left\">\n        <div class=\"z-shell__panel-body\">\n          <div class=\"z-sidebar\">\n            <div class=\"z-sidebar__sections\">\n              <section class=\"z-sidebar__section\" data-open=\"true\">\n                <div class=\"z-sidebar__head\">\n                  <button type=\"button\" class=\"z-sidebar__fold\" aria-expanded=\"true\" aria-controls=\"shell-demo-projects\">\n                    <z-icon name=\"chevron-down-small\" size=\"12\"></z-icon>\n                    <span class=\"z-sidebar__title\">Projects</span>\n                    <span class=\"z-sidebar__count\">2</span>\n                  </button>\n                </div>\n                <div class=\"z-sidebar__body\" id=\"shell-demo-projects\">\n                  <nav aria-label=\"Projects\" class=\"z-navlist\">\n                    <button type=\"button\" class=\"z-navlink\" aria-current=\"page\" data-active=\"true\" data-z-close>\n                      <span class=\"z-navlink__icon\">\n                        <z-icon name=\"folder\" variant=\"solid\" size=\"16\"></z-icon>\n                      </span>\n                      <span class=\"z-navlink__label\">Atlas</span>\n                    </button>\n                    <button type=\"button\" class=\"z-navlink\" data-z-close>\n                      <span class=\"z-navlink__icon\">\n                        <z-icon name=\"folder\" size=\"16\"></z-icon>\n                      </span>\n                      <span class=\"z-navlink__label\">Borealis</span>\n                    </button>\n                  </nav>\n                </div>\n              </section>\n            </div>\n          </div>\n        </div>\n        <div role=\"separator\" tabindex=\"0\" aria-orientation=\"vertical\" aria-label=\"Resize Navigation\" aria-valuenow=\"224\" aria-valuemin=\"180\" aria-valuemax=\"360\" class=\"z-resize\" data-side=\"end\" data-default-size=\"224\"></div>\n      </aside>\n      <main class=\"z-shell__main z-liquid\" id=\"shell-demo-main\" tabindex=\"-1\">\n        <div class=\"z-shell__content\">\n          <div class=\"z-page\" role=\"region\" aria-label=\"Page content\" tabindex=\"0\">\n            <div class=\"z-container\" data-width=\"content\">\n              <header class=\"z-pagehead\">\n                <div class=\"z-pagehead__row\">\n                  <div class=\"z-pagehead__text\">\n                    <h1 class=\"z-pagehead__title\">Overview</h1>\n                    <p class=\"z-pagehead__description\">Panels dock when the shell is wide enough and become drawers when it is not.</p>\n                  </div>\n                </div>\n              </header>\n            </div>\n          </div>\n        </div>\n      </main>\n      <aside class=\"z-liquid z-shell__inspector\" aria-label=\"Details\" data-side=\"right\">\n        <div class=\"z-shell__panel-body\">\n          <section class=\"z-sidepanel\">\n            <div class=\"z-sidepanel__head\">\n              <div class=\"z-sidepanel__titles\">\n                <div class=\"z-sidepanel__title\">Details</div>\n              </div>\n              <div class=\"z-sidepanel__actions\">\n                <button type=\"button\" title=\"Close details\" aria-label=\"Close details\" class=\"z-btn z-btn--icon z-btn--ghost\" data-size=\"sm\" data-z-close>\n                  <z-icon name=\"x-mark\" size=\"16\"></z-icon>\n                </button>\n              </div>\n            </div>\n            <div class=\"z-sidepanel__body\" data-padded=\"true\">Atlas, updated two hours ago.</div>\n          </section>\n        </div>\n      </aside>\n    </div>\n  </div>\n</div>",
     "source": "manual"
    }
   ]
