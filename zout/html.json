   "examples": [
    {
     "title": "Editor, vista previa y salida",
     "html": "<div style=\"width:100%;height:240px\">\n  <div class=\"z-split\" id=\"split-demo\" data-direction=\"row\">\n    <div class=\"z-split__pane\" style=\"flex-grow:0.6\">\n      <div class=\"z-split\" data-direction=\"column\">\n        <div class=\"z-split__pane\" style=\"flex-grow:0.65\">\n          <div class=\"z-pane\" data-focused=\"true\">\n            <div class=\"z-pane__header\">Editor</div>\n            <div class=\"z-pane__body\">\n              <div style=\"padding:var(--z-space-2)\">export const answer = 42;</div>\n            </div>\n          </div>\n        </div>\n        <div role=\"separator\" tabindex=\"0\" aria-orientation=\"horizontal\" aria-label=\"Resize output\" aria-valuenow=\"65\" aria-valuemin=\"10\" aria-valuemax=\"90\" class=\"z-split__divider\"></div>\n        <div class=\"z-split__pane\" style=\"flex-grow:0.35\">\n          <div class=\"z-pane\" data-focused=\"false\">\n            <div class=\"z-pane__header\">Output</div>\n            <div class=\"z-pane__body\">\n              <div style=\"padding:var(--z-space-2)\">ready in 312 ms</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div role=\"separator\" tabindex=\"0\" aria-orientation=\"vertical\" aria-label=\"Resize panes\" aria-valuenow=\"60\" aria-valuemin=\"10\" aria-valuemax=\"90\" class=\"z-split__divider\"></div>\n    <div class=\"z-split__pane\" style=\"flex-grow:0.4\">\n      <div class=\"z-pane\" data-focused=\"false\">\n        <div class=\"z-pane__header\">Preview</div>\n        <div class=\"z-pane__body\">\n              <div style=\"padding:var(--z-space-2)\">42</div>\n            </div>\n      </div>\n    </div>\n  </div>\n</div>",
     "source": "manual"
    }
   ]
