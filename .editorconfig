root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 110

[*.py]
indent_size = 4

# Generados: no se reformatean.
[{pnpm-lock.yaml,**/manifest.json,**/html.json,zicon/icons.json,zicon/icons-own.json,zicon/sprite.svg,zicon/svg/**,zicon/src/icons/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
