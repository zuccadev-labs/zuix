{
  "name": "NodeMinimap",
  "group": "nodes",
  "description": "Minimapa de un NodeCanvas: todos los nodos reducidos y el rectángulo visible. Pulsar o arrastrar mueve la vista; con el foco, las flechas desplazan y + y − hacen zoom.",
  "import": "import { NodeMinimap } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "position",
      "type": "enum",
      "values": ["bottom-right", "bottom-left", "top-right", "top-left"],
      "default": "bottom-right"
    },
    {
      "name": "labels",
      "type": "Partial<NodeCanvasLabels>"
    }
  ],
  "states": ["rest", "focus"],
  "tokens": ["glass-bg", "fg-subtle", "accent", "accent-soft", "danger", "overlay", "radius-md", "layer-raised"],
  "classes": ["z-node-minimap", "z-node-minimap__svg", "z-node-minimap__node", "z-node-minimap__mask", "z-node-minimap__view"],
  "a11y": "nav con nombre («Minimap») y la descripción del lienzo; una parada de Tab. El dibujo es aria-hidden: la información está en los nodos y en NodeListView.",
  "examples": [
    {
      "title": "Arriba a la derecha",
      "code": "<NodeCanvas defaultNodes={[]} minimap={{ position: \"top-right\" }} />"
    }
  ],
  "html": [
    {
      "title": "Minimapa",
      "code": "<nav class=\"z-node-minimap z-liquid\" aria-label=\"Minimap\" tabindex=\"0\"></nav>"
    }
  ]
}
