{
  "name": "Tree",
  "group": "navigation",
  "description": "Árbol jerárquico con expansión, selección y navegación por teclado.",
  "import": "import { Tree, type TreeNode } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "nodes",
      "type": "TreeNode[]",
      "required": true,
      "description": "{ id, label, icon?, disabled?, children? }"
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Nombre accesible."
    },
    {
      "name": "expanded",
      "type": "string[]",
      "description": "Ids expandidos (controlado)."
    },
    {
      "name": "defaultExpanded",
      "type": "string[]"
    },
    {
      "name": "onExpandedChange",
      "type": "(ids: string[]) => void"
    },
    {
      "name": "selected",
      "type": "string | null"
    },
    {
      "name": "defaultSelected",
      "type": "string | null"
    },
    {
      "name": "onSelect",
      "type": "(id: string, node: TreeNode) => void"
    }
  ],
  "states": [
    "rest",
    "hover",
    "focus",
    "selected",
    "expanded",
    "collapsed",
    "disabled"
  ],
  "tokens": [
    "duration-fast",
    "ease-standard",
    "fg",
    "fg-muted",
    "fg-subtle",
    "focus-ring",
    "radius-xs",
    "row-hover",
    "space-1",
    "space-2",
    "space-4",
    "surface-2",
    "text-small"
  ],
  "classes": [
    "z-tree",
    "z-tree__item",
    "z-tree__row",
    "z-tree__toggle",
    "z-tree__icon",
    "z-tree__label",
    "z-tree__group"
  ],
  "a11y": "Roles tree, treeitem y group con aria-expanded, aria-selected, aria-level, aria-setsize y aria-posinset. Foco itinerante: arriba/abajo recorren, derecha expande o entra, izquierda pliega o sube al padre, Inicio/Fin, Intro o Espacio seleccionan.",
  "examples": [
    {
      "title": "Explorador de archivos",
      "code": "<Tree\n  label=\"Project files\"\n  defaultExpanded={[\"src\"]}\n  onSelect={(id) => openFile(id)}\n  nodes={[\n    { id: \"src\", label: \"src\", icon: \"folder\", children: [\n      { id: \"src/index.ts\", label: \"index.ts\", icon: \"document\" },\n      { id: \"src/app.tsx\", label: \"app.tsx\", icon: \"document\" },\n    ] },\n    { id: \"readme\", label: \"README.md\", icon: \"document\" },\n  ]}\n/>"
    }
  ],
  "origin": "Nuevo, con el aspecto de las filas de lista de zutool.",
  "behavior": "dom",
  "html": [
    {
      "title": "Explorador de archivos (las ramas plegadas llevan hidden; emite z:change)",
      "code": "<ul role=\"tree\" aria-label=\"Project files\" class=\"z-tree\">\n  <li role=\"treeitem\" class=\"z-tree__item\" aria-expanded=\"true\" aria-selected=\"false\" aria-level=\"1\" aria-setsize=\"3\" aria-posinset=\"1\" tabindex=\"0\" data-value=\"src\">\n    <div class=\"z-tree__row\" style=\"--z-tree-level:0\">\n      <span class=\"z-tree__toggle\" data-state=\"open\" aria-hidden=\"true\"><z-icon name=\"chevron-right\" size=\"12\"></z-icon></span>\n      <span class=\"z-tree__icon\"><z-icon name=\"folder\" size=\"14\"></z-icon></span>\n      <span class=\"z-tree__label\">src</span>\n    </div>\n    <ul role=\"group\" class=\"z-tree__group\">\n      <li role=\"treeitem\" class=\"z-tree__item\" aria-selected=\"false\" aria-level=\"2\" aria-setsize=\"3\" aria-posinset=\"1\" tabindex=\"-1\" data-value=\"src/index.ts\">\n        <div class=\"z-tree__row\" style=\"--z-tree-level:1\">\n          <span class=\"z-tree__toggle\" data-state=\"closed\" aria-hidden=\"true\"></span>\n          <span class=\"z-tree__icon\"><z-icon name=\"document\" size=\"14\"></z-icon></span>\n          <span class=\"z-tree__label\">index.ts</span>\n        </div>\n      </li>\n      <li role=\"treeitem\" class=\"z-tree__item\" aria-selected=\"false\" aria-level=\"2\" aria-setsize=\"3\" aria-posinset=\"2\" tabindex=\"-1\" data-value=\"src/app.tsx\">\n        <div class=\"z-tree__row\" style=\"--z-tree-level:1\">\n          <span class=\"z-tree__toggle\" data-state=\"closed\" aria-hidden=\"true\"></span>\n          <span class=\"z-tree__icon\"><z-icon name=\"document\" size=\"14\"></z-icon></span>\n          <span class=\"z-tree__label\">app.tsx</span>\n        </div>\n      </li>\n      <li role=\"treeitem\" class=\"z-tree__item\" aria-expanded=\"false\" aria-selected=\"false\" aria-level=\"2\" aria-setsize=\"3\" aria-posinset=\"3\" tabindex=\"-1\" data-value=\"src/styles\">\n        <div class=\"z-tree__row\" style=\"--z-tree-level:1\">\n          <span class=\"z-tree__toggle\" data-state=\"closed\" aria-hidden=\"true\"><z-icon name=\"chevron-right\" size=\"12\"></z-icon></span>\n          <span class=\"z-tree__icon\"><z-icon name=\"folder\" size=\"14\"></z-icon></span>\n          <span class=\"z-tree__label\">styles</span>\n        </div>\n        <ul role=\"group\" class=\"z-tree__group\" hidden>\n          <li role=\"treeitem\" class=\"z-tree__item\" aria-selected=\"false\" aria-level=\"3\" aria-setsize=\"2\" aria-posinset=\"1\" tabindex=\"-1\" data-value=\"src/styles/base.css\">\n            <div class=\"z-tree__row\" style=\"--z-tree-level:2\">\n              <span class=\"z-tree__toggle\" data-state=\"closed\" aria-hidden=\"true\"></span>\n              <span class=\"z-tree__icon\"><z-icon name=\"document\" size=\"14\"></z-icon></span>\n              <span class=\"z-tree__label\">base.css</span>\n            </div>\n          </li>\n          <li role=\"treeitem\" class=\"z-tree__item\" aria-selected=\"false\" aria-level=\"3\" aria-setsize=\"2\" aria-posinset=\"2\" tabindex=\"-1\" data-value=\"src/styles/theme.css\">\n            <div class=\"z-tree__row\" style=\"--z-tree-level:2\">\n              <span class=\"z-tree__toggle\" data-state=\"closed\" aria-hidden=\"true\"></span>\n              <span class=\"z-tree__icon\"><z-icon name=\"document\" size=\"14\"></z-icon></span>\n              <span class=\"z-tree__label\">theme.css</span>\n            </div>\n          </li>\n        </ul>\n      </li>\n    </ul>\n  </li>\n  <li role=\"treeitem\" class=\"z-tree__item\" aria-expanded=\"false\" aria-selected=\"false\" aria-level=\"1\" aria-setsize=\"3\" aria-posinset=\"2\" tabindex=\"-1\" data-value=\"docs\" aria-disabled=\"true\">\n    <div class=\"z-tree__row\" style=\"--z-tree-level:0\">\n      <span class=\"z-tree__toggle\" data-state=\"closed\" aria-hidden=\"true\"><z-icon name=\"chevron-right\" size=\"12\"></z-icon></span>\n      <span class=\"z-tree__icon\"><z-icon name=\"folder\" size=\"14\"></z-icon></span>\n      <span class=\"z-tree__label\">docs</span>\n    </div>\n    <ul role=\"group\" class=\"z-tree__group\" hidden>\n      <li role=\"treeitem\" class=\"z-tree__item\" aria-selected=\"false\" aria-level=\"2\" aria-setsize=\"1\" aria-posinset=\"1\" tabindex=\"-1\" data-value=\"docs/guide.md\">\n        <div class=\"z-tree__row\" style=\"--z-tree-level:1\">\n          <span class=\"z-tree__toggle\" data-state=\"closed\" aria-hidden=\"true\"></span>\n          <span class=\"z-tree__icon\"><z-icon name=\"document\" size=\"14\"></z-icon></span>\n          <span class=\"z-tree__label\">guide.md</span>\n        </div>\n      </li>\n    </ul>\n  </li>\n  <li role=\"treeitem\" class=\"z-tree__item\" aria-selected=\"false\" aria-level=\"1\" aria-setsize=\"3\" aria-posinset=\"3\" tabindex=\"-1\" data-value=\"README.md\">\n    <div class=\"z-tree__row\" style=\"--z-tree-level:0\">\n      <span class=\"z-tree__toggle\" data-state=\"closed\" aria-hidden=\"true\"></span>\n      <span class=\"z-tree__icon\"><z-icon name=\"document\" size=\"14\"></z-icon></span>\n      <span class=\"z-tree__label\">README.md</span>\n    </div>\n  </li>\n</ul>"
    }
  ]
}
