{
  "name": "CodeBlock",
  "group": "content",
  "description": "Bloque de código sin resaltado, con botón de copiar.",
  "import": "import { CodeBlock } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "code",
      "type": "string",
      "required": true
    },
    {
      "name": "title",
      "type": "ReactNode",
      "description": "Rótulo de cabecera, p. ej. el nombre del archivo."
    },
    {
      "name": "language",
      "type": "string",
      "description": "Se muestra en la cabecera y se expone como data-language."
    },
    {
      "name": "wrap",
      "type": "boolean",
      "default": false,
      "description": "Ajusta las líneas largas."
    },
    {
      "name": "maxHeight",
      "type": "string",
      "description": "Alto máximo (longitud CSS)."
    },
    {
      "name": "hideCopy",
      "type": "boolean",
      "default": false
    },
    {
      "name": "copyLabel",
      "type": "string",
      "default": "Copy"
    },
    {
      "name": "copiedLabel",
      "type": "string",
      "default": "Copied"
    },
    {
      "name": "label",
      "type": "string",
      "default": "Code",
      "description": "Nombre accesible de la región de código."
    },
    {
      "name": "onCopy",
      "type": "(code: string) => void"
    }
  ],
  "states": ["rest", "hover", "focus", "active", "copied"],
  "tokens": [
    "line",
    "code-bg",
    "fg",
    "space-2",
    "space-4",
    "fg-muted",
    "text-small",
    "font-mono",
    "fg-subtle",
    "text-caption",
    "tracking-wide",
    "accent-ring",
    "space-1",
    "font-sans",
    "duration-fast",
    "ease-standard",
    "surface-solid",
    "line-strong",
    "layer-raised",
    "code-bar-bg",
    "code-radius",
    "control-height-sm",
    "control-radius-sm",
    "duration-press",
    "ease-out",
    "focus-offset",
    "focus-width",
    "glass-border",
    "glass-highlight",
    "leading-code",
    "space-2-5",
    "space-5",
    "success-text",
    "surface-2",
    "text-code",
    "weight-medium"
  ],
  "classes": ["z-code"],
  "a11y": "pre enfocable con role region para desplazarlo con teclado. El botón anuncia \"Copied\" por aria-live.",
  "examples": [
    {
      "title": "Con cabecera",
      "code": "<CodeBlock title=\"install.sh\" language=\"bash\" code={\"pnpm add @zuccadev-labs/zuix\\npnpm dev\"} />"
    },
    {
      "title": "Sin cabecera, con alto máximo",
      "code": "<CodeBlock code={JSON.stringify(config, null, 2)} maxHeight=\"240px\" wrap />"
    }
  ],
  "origin": "Nuevo."
}
