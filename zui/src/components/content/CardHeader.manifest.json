{
  "name": "CardHeader",
  "group": "content",
  "description": "Cabecera de una Card: título, subtítulo y acción.",
  "import": "import { CardHeader } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "title",
      "type": "ReactNode",
      "required": true
    },
    {
      "name": "subtitle",
      "type": "ReactNode"
    },
    {
      "name": "action",
      "type": "ReactNode",
      "description": "Alineada a la derecha."
    },
    {
      "name": "headingLevel",
      "type": "2 | 3 | 4",
      "default": 3
    },
    {
      "name": "icon",
      "type": "IconName",
      "description": "Icono en una baldosa delante del título (decorativo)."
    },
    {
      "name": "href",
      "type": "string",
      "description": "El título es un enlace (.z-card__link) cuya zona de clic cubre la tarjeta; los demás controles siguen por encima."
    }
  ],
  "states": [
    "rest"
  ],
  "tokens": [
    "space-3",
    "font-display",
    "weight-semibold",
    "leading-snug",
    "fg-muted",
    "text-small",
    "space-2",
    "fg",
    "leading-ui",
    "text-title",
    "tracking-snug",
    "control-height-md",
    "control-radius",
    "surface-2",
    "accent-text",
    "glass-highlight",
    "line"
  ],
  "classes": [
    "z-card__header",
    "z-card__heading",
    "z-card__title",
    "z-card__subtitle",
    "z-card__action",
    "z-card__icon"
  ],
  "a11y": "El título es un encabezado real con nivel configurable.",
  "examples": [
    {
      "title": "Con acción",
      "code": "<Card>\n  <CardHeader title=\"Members\" subtitle=\"5 people\" action={<IconButton icon=\"plus\" label=\"Add member\" />} />\n</Card>"
    },
    {
      "title": "Con icono",
      "code": "<CardHeader icon=\"chart-bar\" title=\"Usage\" subtitle=\"Last 30 days\" />"
    }
  ],
  "origin": "CardHeader del design system base."
}
