{
  "name": "YearPicker",
  "group": "forms",
  "description": "Selector de año: DatePicker en la vista de década (rejilla 3 × 4 con los años del borde atenuados). Valor YYYY.",
  "import": "import { YearPicker } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "value",
      "type": "string | null"
    },
    {
      "name": "defaultValue",
      "type": "string | null"
    },
    {
      "name": "onValueChange",
      "type": "(value: string | null) => void"
    },
    {
      "name": "min",
      "type": "string"
    },
    {
      "name": "max",
      "type": "string"
    },
    {
      "name": "locale",
      "type": "string"
    },
    {
      "name": "placeholder",
      "type": "string"
    },
    {
      "name": "name",
      "type": "string"
    },
    {
      "name": "required",
      "type": "boolean"
    },
    {
      "name": "disabled",
      "type": "boolean"
    },
    {
      "name": "size",
      "type": "enum",
      "values": ["sm", "md", "lg"],
      "default": "md"
    },
    {
      "name": "...DatePicker",
      "type": "DatePickerProps",
      "description": "El resto de props de DatePicker."
    },
    {
      "name": "mode",
      "type": "enum",
      "values": ["single", "range"],
      "default": "single"
    }
  ],
  "states": ["rest", "hover", "focus", "open", "disabled", "invalid"],
  "tokens": [
    "accent",
    "accent-ring",
    "accent-soft",
    "calendar-cell",
    "control-bg",
    "control-border",
    "control-border-hover",
    "control-height-lg",
    "control-height-md",
    "control-height-sm",
    "control-radius",
    "danger",
    "duration-fast",
    "ease-standard",
    "fg",
    "fg-muted",
    "fg-subtle",
    "focus-width",
    "leading-snug",
    "line-strong",
    "popup-bg",
    "popup-radius",
    "radius-full",
    "row-hover",
    "space-2",
    "space-3",
    "space-8",
    "surface",
    "surface-3",
    "text-body",
    "text-caption",
    "text-small",
    "text-title",
    "weight-medium",
    "weight-semibold"
  ],
  "classes": ["z-datepicker", "z-calendar"],
  "a11y": "Rejilla APG de 12 años (la década y uno a cada lado): flechas por celda, RePág/AvPág por década, con Mayús por siglo. Sin React: data-min-view=\"year\".",
  "behavior": "dom",
  "examples": [
    {
      "title": "Año de fabricación",
      "code": "<YearPicker aria-label=\"Model year\" locale=\"en-US\" min=\"1990\" max=\"2027\" defaultValue=\"2024\" />"
    }
  ],
  "html": [
    {
      "title": "Año de fabricación",
      "code": "<span class=\"z-select z-datepicker\" id=\"model-year\" data-size=\"md\" data-block data-min-view=\"year\" data-locale=\"en-US\" data-min=\"1990\" data-max=\"2027\" data-value=\"2024\">\n  <button type=\"button\" class=\"z-select__control\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"model-year-panel\" data-state=\"closed\">\n    <span class=\"z-sr-only\">Model year</span>\n    <span class=\"z-select__value\">2024</span>\n  </button>\n  <span class=\"z-select__chevron\"><z-icon name=\"calendar\" size=\"16\"></z-icon></span>\n  <input type=\"hidden\" name=\"model-year\" value=\"2024\" />\n</span>\n\n<div id=\"model-year-panel\" popover=\"manual\" class=\"z-liquid z-popover z-datepicker__panel\" role=\"dialog\" aria-label=\"Choose year\">\n  <div class=\"z-calendar\"></div>\n</div>"
    }
  ],
  "origin": "Year Picker de Shark UI."
}
