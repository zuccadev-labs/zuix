{
  "name": "Radio",
  "group": "forms",
  "description": "Opción de un `RadioGroup`, con etiqueta y descripción.",
  "import": "import { RadioGroup, Radio } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "value",
      "type": "string",
      "required": true
    },
    {
      "name": "children",
      "type": "ReactNode",
      "description": "Etiqueta visible."
    },
    {
      "name": "description",
      "type": "ReactNode"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false
    }
  ],
  "states": ["rest", "hover", "focus", "active", "checked", "disabled"],
  "tokens": [
    "space-2",
    "fg",
    "text-body",
    "leading-snug",
    "control-bg",
    "fg-on-accent",
    "duration-fast",
    "ease-standard",
    "radius-full",
    "accent",
    "accent-solid",
    "danger",
    "accent-ring",
    "control-border",
    "fg-muted",
    "focus-offset",
    "focus-width",
    "touch-target"
  ],
  "classes": ["z-radio", "z-check__text"],
  "a11y": "Botón con role radio y un `input type=radio` oculto para formularios. Solo funciona dentro de `RadioGroup`.",
  "examples": [
    {
      "title": "Dentro de un grupo",
      "code": "<RadioGroup aria-label=\"Theme\" defaultValue=\"dark\">\n  <Radio value=\"light\">Light</Radio>\n  <Radio value=\"dark\">Dark</Radio>\n</RadioGroup>"
    }
  ],
  "origin": "Nuevo, con primitiva propia (patrón APG)."
}
