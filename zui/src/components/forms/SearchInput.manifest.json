{
  "name": "SearchInput",
  "group": "forms",
  "description": "Campo de búsqueda con icono, botón de borrado y estado de carga.",
  "import": "import { SearchInput } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "value",
      "type": "string"
    },
    {
      "name": "defaultValue",
      "type": "string",
      "default": ""
    },
    {
      "name": "onValueChange",
      "type": "(value: string) => void"
    },
    {
      "name": "onSearch",
      "type": "(value: string) => void",
      "description": "Al pulsar Enter."
    },
    {
      "name": "onClear",
      "type": "() => void"
    },
    {
      "name": "size",
      "type": "enum",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md"
    },
    {
      "name": "placeholder",
      "type": "string",
      "default": "Search",
      "description": "También es el nombre accesible por defecto."
    },
    {
      "name": "clearLabel",
      "type": "string",
      "default": "Clear search"
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": false
    },
    {
      "name": "...rest",
      "type": "InputHTMLAttributes"
    }
  ],
  "states": [
    "rest",
    "hover",
    "focus",
    "active",
    "disabled",
    "loading"
  ],
  "tokens": [
    "control-height-md",
    "space-3",
    "space-2",
    "control-border",
    "control-radius",
    "control-bg",
    "fg",
    "text-body",
    "duration-fast",
    "ease-standard",
    "control-border-hover",
    "accent",
    "focus-ring",
    "surface",
    "danger",
    "danger-soft",
    "control-height-sm",
    "text-small",
    "control-height-lg",
    "space-4",
    "text-title",
    "font-mono",
    "fg-subtle",
    "space-1",
    "radius-xs",
    "fg-muted",
    "surface-3",
    "radius-full"
  ],
  "classes": [
    "z-input",
    "z-input--search"
  ],
  "a11y": "input type=\"search\". Escape borra el texto; el botón de borrado tiene nombre accesible y devuelve el foco al campo.",
  "examples": [
    {
      "title": "Controlado",
      "code": "<SearchInput value={query} onValueChange={setQuery} placeholder=\"Search projects\" />"
    },
    {
      "title": "Con envío y carga",
      "code": "<SearchInput onSearch={(text) => runSearch(text)} loading={isSearching} aria-label=\"Search the catalogue\" />"
    }
  ],
  "origin": "Píldora de búsqueda de zutool."
}
