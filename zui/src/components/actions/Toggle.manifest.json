{
  "name": "Toggle",
  "group": "actions",
  "description": "Botón de dos estados (activado o no), con texto, icono o ambos.",
  "import": "import { Toggle } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "pressed",
      "type": "boolean",
      "description": "Estado controlado."
    },
    {
      "name": "defaultPressed",
      "type": "boolean",
      "default": false
    },
    {
      "name": "onPressedChange",
      "type": "(pressed: boolean) => void"
    },
    {
      "name": "size",
      "type": "enum",
      "values": ["sm", "md", "lg"],
      "default": "md"
    },
    {
      "name": "variant",
      "type": "enum",
      "values": ["outline", "ghost"],
      "default": "outline",
      "description": "`outline` con canto; `ghost` sin canto hasta pasar el puntero o activarse."
    },
    {
      "name": "icon",
      "type": "IconName"
    },
    {
      "name": "label",
      "type": "string",
      "description": "Nombre accesible; obligatorio cuando solo hay icono."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false
    }
  ],
  "states": ["rest", "hover", "focus", "active", "on", "disabled"],
  "tokens": [
    "space-2",
    "control-height-md",
    "space-3",
    "line",
    "button-radius",
    "fg-muted",
    "text-body",
    "weight-semibold",
    "duration-fast",
    "ease-standard",
    "surface-2",
    "fg",
    "accent-soft",
    "accent-ring",
    "control-height-sm",
    "text-small",
    "control-height-lg",
    "space-4",
    "text-title",
    "accent-text",
    "duration-press",
    "ease-out",
    "focus-offset",
    "focus-width",
    "control-radius-sm",
    "control-radius-lg"
  ],
  "classes": ["z-toggle"],
  "a11y": "Elemento button con aria-pressed y data-state on/off.",
  "examples": [
    {
      "title": "Solo icono",
      "code": "<Toggle icon=\"star\" label=\"Favourite\" defaultPressed />"
    },
    {
      "title": "Controlado con texto",
      "code": "<Toggle pressed={muted} onPressedChange={setMuted} icon=\"speaker-x-mark\">Mute</Toggle>"
    },
    {
      "title": "Fantasma y contorno",
      "code": "<>\n  <Toggle icon=\"bold\" label=\"Bold\" variant=\"ghost\" />\n  <Toggle icon=\"italic\" label=\"Italic\" defaultPressed />\n</>"
    }
  ],
  "origin": "Nuevo, con primitiva propia (patrón APG)."
}
