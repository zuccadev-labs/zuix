{
  "name": "Modal",
  "group": "overlay",
  "description": "Diálogo modal centrado sobre un velo, con título, descripción, cuerpo y pie.",
  "import": "import { Modal } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "description": "Estado controlado."
    },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "default": false
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void"
    },
    {
      "name": "trigger",
      "type": "ReactElement",
      "description": "Elemento que abre el modal (uso no controlado)."
    },
    {
      "name": "title",
      "type": "ReactNode"
    },
    {
      "name": "description",
      "type": "ReactNode"
    },
    {
      "name": "label",
      "type": "string",
      "default": "Dialog",
      "description": "Nombre accesible cuando no hay título visible."
    },
    {
      "name": "size",
      "type": "enum",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "description": "Ancho máximo: 400, 560 o 720 px."
    },
    {
      "name": "fullScreen",
      "type": "enum",
      "values": [
        "none",
        "compact",
        "always"
      ],
      "default": "none",
      "description": "A pantalla completa (Material 3 Expressive): `compact` en ventanas de menos de 600 px, `always` siempre. Todo el alto, el pie fijo abajo y las zonas seguras."
    },
    {
      "name": "footer",
      "type": "ReactNode",
      "description": "Fila de acciones alineada a la derecha."
    },
    {
      "name": "dismissible",
      "type": "boolean",
      "default": true,
      "description": "Escape y clic fuera cierran."
    },
    {
      "name": "hideClose",
      "type": "boolean",
      "default": false
    },
    {
      "name": "closeLabel",
      "type": "string",
      "default": "Close"
    },
    {
      "name": "children",
      "type": "ReactNode"
    }
  ],
  "states": [
    "open",
    "closed"
  ],
  "tokens": [
    "duration-fast",
    "duration-normal",
    "ease-out",
    "ease-standard",
    "fg",
    "fg-muted",
    "font-sans",
    "glass-blur",
    "glass-border",
    "glass-highlight",
    "glass-saturate",
    "glass-shadow",
    "glass-specular",
    "layer-dialog",
    "leading-normal",
    "leading-relaxed",
    "leading-snug",
    "popup-bg",
    "scrim",
    "space-12",
    "space-2",
    "space-3",
    "space-4",
    "space-5",
    "space-8",
    "text-body",
    "text-small",
    "weight-semibold",
    "accent-ring",
    "control-radius-sm",
    "duration-press",
    "ease-emphasized",
    "ease-exit",
    "fg-prose",
    "focus-offset",
    "focus-width",
    "leading-ui",
    "popup-blur",
    "popup-shadow",
    "radius-panel",
    "space-1",
    "space-6",
    "surface-2",
    "text-title",
    "touch-target",
    "tracking-snug"
  ],
  "classes": [
    "z-modal",
    "z-modal__header",
    "z-modal__title",
    "z-modal__description",
    "z-modal__body",
    "z-modal__footer",
    "z-modal__close",
    "z-overlay-close"
  ],
  "a11y": "`<dialog>` abierto con `showModal()`: el resto de la página queda inerte, Tab da la vuelta dentro, Escape cierra y el foco vuelve al disparador. El título nombra el diálogo; sin título se usa `label` como `aria-label`.",
  "examples": [
    {
      "title": "Con disparador y pie",
      "code": "<Modal\n  trigger={<button type=\"button\">Edit profile</button>}\n  title=\"Edit profile\"\n  description=\"Changes are saved to your account.\"\n  footer={<button type=\"button\">Save</button>}\n>\n  <p>Form fields go here.</p>\n</Modal>"
    },
    {
      "title": "Controlado, tamaño grande",
      "code": "<Modal open={open} onOpenChange={setOpen} size=\"lg\" title=\"Release notes\">\n  <p>Version 2.4 brings a new command palette.</p>\n</Modal>"
    },
    {
      "title": "A pantalla completa en el teléfono",
      "code": "<Modal\n  trigger={<button type=\"button\">New event</button>}\n  title=\"New event\"\n  fullScreen=\"compact\"\n  footer={<button type=\"button\">Save</button>}\n>\n  <p>Fields of the event.</p>\n</Modal>"
    }
  ],
  "origin": "Tamaños y API de Modal de design system base; material y animación de los diálogos de zutool; accesibilidad según el patrón APG, con primitivas propias.",
  "behavior": "dom",
  "html": [
    {
      "title": "Modal con pie",
      "code": "<button type=\"button\" class=\"z-btn z-btn--secondary\" data-size=\"md\" data-z-open=\"#edit-profile\">Edit profile</button>\n\n<dialog id=\"edit-profile\" class=\"z-liquid z-modal\" data-size=\"md\" aria-labelledby=\"edit-profile-title\">\n  <header class=\"z-modal__header\">\n    <div class=\"z-modal__heading\">\n      <h2 id=\"edit-profile-title\" class=\"z-modal__title\">Edit profile</h2>\n      <p class=\"z-modal__description\">Changes apply to your whole workspace.</p>\n    </div>\n  </header>\n  <div class=\"z-modal__body\">Your content.</div>\n  <footer class=\"z-modal__footer\">\n    <button type=\"button\" class=\"z-dialog-btn\" data-variant=\"secondary\" data-z-close>Cancel</button>\n    <button type=\"button\" class=\"z-dialog-btn\" data-variant=\"primary\" data-z-close value=\"save\">Save</button>\n  </footer>\n  <button type=\"button\" class=\"z-overlay-close z-modal__close\" aria-label=\"Close\" data-z-close>\n    <z-icon name=\"x-mark\" size=\"16\"></z-icon>\n  </button>\n</dialog>"
    },
    {
      "title": "A pantalla completa en el teléfono",
      "code": "<button type=\"button\" class=\"z-btn z-btn--secondary\" data-size=\"md\" data-z-open=\"#new-event\">New event</button>\n\n<dialog id=\"new-event\" class=\"z-liquid z-modal\" data-size=\"md\" data-fullscreen=\"compact\" aria-labelledby=\"new-event-title\">\n  <header class=\"z-modal__header\">\n    <div class=\"z-modal__heading\">\n      <h2 id=\"new-event-title\" class=\"z-modal__title\">New event</h2>\n    </div>\n  </header>\n  <div class=\"z-modal__body\">Fields of the event.</div>\n  <footer class=\"z-modal__footer\">\n    <button type=\"button\" class=\"z-dialog-btn\" data-variant=\"secondary\" data-z-close>Cancel</button>\n    <button type=\"button\" class=\"z-dialog-btn\" data-variant=\"primary\" data-z-close value=\"save\">Save</button>\n  </footer>\n  <button type=\"button\" class=\"z-overlay-close z-modal__close\" aria-label=\"Close\" data-z-close>\n    <z-icon name=\"x-mark\" size=\"16\"></z-icon>\n  </button>\n</dialog>"
    }
  ]
}
