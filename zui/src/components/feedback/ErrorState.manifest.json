{
  "name": "ErrorState",
  "group": "feedback",
  "description": "Estado de error recuperable, con reintento opcional.",
  "import": "import { ErrorState } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "icon",
      "type": "IconName",
      "default": "exclamation-triangle"
    },
    {
      "name": "title",
      "type": "ReactNode",
      "default": "Something went wrong"
    },
    {
      "name": "message",
      "type": "ReactNode",
      "default": "The content could not be loaded. Try again in a moment."
    },
    {
      "name": "onRetry",
      "type": "() => void",
      "description": "Muestra el botón de reintento."
    },
    {
      "name": "retryLabel",
      "type": "string",
      "default": "Try again"
    },
    {
      "name": "actions",
      "type": "ReactNode",
      "description": "Acciones adicionales."
    },
    {
      "name": "fullScreen",
      "type": "boolean",
      "default": false
    },
    {
      "name": "headingLevel",
      "type": "2 | 3 | 4",
      "default": 3
    }
  ],
  "states": ["rest"],
  "tokens": [
    "space-2",
    "space-10",
    "space-6",
    "fg-muted",
    "space-4",
    "line",
    "surface-2",
    "danger-soft",
    "fg",
    "font-display",
    "leading-snug",
    "text-title",
    "text-body",
    "leading-normal",
    "text-small",
    "space-3",
    "control-radius-lg",
    "danger-text",
    "glass-border",
    "glass-highlight",
    "radius-md",
    "shadow-sm",
    "space-12",
    "space-9",
    "text-heading",
    "tracking-snug",
    "weight-display"
  ],
  "classes": ["z-empty", "z-empty--error"],
  "a11y": "role=\"alert\": se anuncia al aparecer.",
  "examples": [
    {
      "title": "Con reintento",
      "code": "<ErrorState onRetry={() => refetch()} />"
    },
    {
      "title": "Mensaje propio",
      "code": "<ErrorState title=\"Report unavailable\" message=\"The export service is not responding.\" retryLabel=\"Retry export\" onRetry={retryExport} actions={<Button variant=\"ghost\">Contact support</Button>} />"
    }
  ],
  "origin": "ErrorState del design system base."
}
