{
  "name": "Spinner",
  "group": "feedback",
  "description": "Indicador de espera de duración desconocida: anillo giratorio, tres puntos que laten o cuatro barras.",
  "import": "import { Spinner } from \"@zuccadev-labs/zuix-zui\"",
  "props": [
    {
      "name": "size",
      "type": "enum",
      "values": ["sm", "md", "lg"],
      "default": "md"
    },
    {
      "name": "tone",
      "type": "enum",
      "values": ["accent", "muted", "current"],
      "default": "accent",
      "description": "`current` hereda el color del texto."
    },
    {
      "name": "shape",
      "type": "enum",
      "values": ["ring", "dots", "bars"],
      "default": "ring",
      "description": "Forma del indicador."
    },
    {
      "name": "label",
      "type": "string",
      "default": "Loading",
      "description": "Nombre accesible; cadena vacía lo vuelve decorativo."
    }
  ],
  "states": ["spinning"],
  "tokens": ["surface-3", "accent", "radius-full", "fg-muted", "ease-standard"],
  "classes": ["z-spinner", "z-spinner__part"],
  "a11y": "role=\"status\" con aria-label; decorativo si `label` está vacío. Con movimiento reducido las formas de puntos y barras quedan quietas en un escalón de opacidad que se sigue leyendo como espera.",
  "examples": [
    {
      "title": "Básico",
      "code": "<Spinner />"
    },
    {
      "title": "Dentro de un texto",
      "code": "<p><Spinner size=\"sm\" tone=\"current\" label=\"\" /> Saving changes</p>"
    },
    {
      "title": "Formas",
      "code": "<>\n  <Spinner shape=\"ring\" />\n  <Spinner shape=\"dots\" />\n  <Spinner shape=\"bars\" />\n</>"
    },
    {
      "title": "Barras en un botón",
      "code": "<p><Spinner shape=\"dots\" size=\"sm\" tone=\"current\" label=\"\" /> Generating summary</p>"
    }
  ],
  "origin": "Spinner del design system base."
}
