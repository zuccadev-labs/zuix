{
  "name": "@zuccadev-labs/zuix-zui",
  "version": "0.2.0",
  "type": "module",
  "description": "Sistema de componentes de la suite zuix. Contrato HTML + CSS sobre tokens, comportamiento sin framework (dom) y binding de React, sin dependencias de terceros.",
  "license": "MIT",
  "keywords": [
    "zuix",
    "components",
    "ui",
    "design-system",
    "react",
    "accessibility",
    "liquid-glass",
    "html",
    "css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuccadev-labs/zuix.git",
    "directory": "zui"
  },
  "homepage": "https://github.com/zuccadev-labs/zuix/tree/main/zui#readme",
  "bugs": {
    "url": "https://github.com/zuccadev-labs/zuix/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./manifest.json": "./manifest.json",
    "./dom": "./src/dom/index.ts",
    "./dom/carousel-gl": "./src/dom/carousel-gl.ts",
    "./html.json": "./html.json",
    "./dist/zui.css": "./dist/zui.css",
    "./dist/zui.dom.js": "./dist/zui.dom.js",
    "./dist/zui.dom.carousel-gl.js": "./dist/zui.dom.carousel-gl.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@zuccadev-labs/zuix-zicon": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@zuccadev-labs/zuix-tokens": "workspace:^"
  },
  "devDependencies": {
    "@zuccadev-labs/zuix-zicon": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "manifest.json",
    "html.json",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/dom/*.ts",
    "./dist/esm/dom/*.js",
    "./dist/zui.dom.js"
  ],
  "publishConfig": {
    "main": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "./dom": {
        "types": "./dist/esm/dom/index.d.ts",
        "default": "./dist/esm/dom/index.js"
      },
      "./dom/carousel-gl": {
        "types": "./dist/esm/dom/carousel-gl.d.ts",
        "default": "./dist/esm/dom/carousel-gl.js"
      },
      "./styles.css": "./dist/zui.css",
      "./styles/*": "./dist/styles/*",
      "./manifest.json": "./manifest.json",
      "./html.json": "./html.json",
      "./dist/zui.css": "./dist/zui.css",
      "./dist/zui.dom.js": {
        "types": "./dist/esm/dom/index.d.ts",
        "default": "./dist/zui.dom.js"
      },
      "./dist/zui.dom.carousel-gl.js": {
        "types": "./dist/esm/dom/carousel-gl.d.ts",
        "default": "./dist/zui.dom.carousel-gl.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  }
}
