      },
      "./dom/terminal": {
        "types": "./dist/esm/dom/families/terminal.d.ts",
        "default": "./dist/esm/dom/families/terminal.js"
      },
      "./dom/chat": {
        "types": "./dist/esm/dom/families/chat.d.ts",
