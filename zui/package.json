{
  "name": "@zuccadev-labs/zuix-zui",
  "version": "0.4.0",
  "type": "module",
  "description": "Sistema de componentes de la suite zuix. Contrato HTML + CSS sobre tokens, comportamiento sin framework (dom) y binding de React, sin dependencias de terceros.",
  "license": "MIT",
  "keywords": [
    "zuix",
    "components",
    "ui",
    "design-system",
    "react",
    "accessibility",
    "liquid-glass",
    "html",
    "css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuccadev-labs/zuix.git",
    "directory": "zui"
  },
  "homepage": "https://github.com/zuccadev-labs/zuix/tree/main/zui#readme",
  "bugs": {
    "url": "https://github.com/zuccadev-labs/zuix/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./styles.compat.css": "./dist/zui.compat.css",
    "./styles/*": "./src/styles/*",
    "./manifest.json": "./manifest.json",
    "./dom": "./src/dom/index.ts",
    "./dom/core": "./src/dom/core.ts",
    "./dom/dates": "./src/dom/families/dates.ts",
    "./dom/data": "./src/dom/families/data.ts",
    "./dom/content": "./src/dom/families/content.ts",
    "./dom/agenda": "./src/dom/families/agenda.ts",
    "./dom/charts": "./src/dom/families/charts.ts",
    "./dom/color": "./src/dom/families/color.ts",
    "./dom/media": "./src/dom/families/media.ts",
    "./dom/effects": "./src/dom/families/effects.ts",
    "./dom/time": "./src/dom/families/time.ts",
    "./dom/terminal": "./src/dom/families/terminal.ts",
    "./dom/chat": "./src/dom/families/chat.ts",
    "./dom/ai": "./src/dom/families/ai.ts",
    "./dom/dashboard": "./src/dom/families/dashboard.ts",
    "./dom/people": "./src/dom/families/people.ts",
    "./dom/nodes": "./src/dom/families/nodes.ts",
    "./dom/carousel-gl": "./src/dom/carousel-gl.ts",
    "./html.json": "./html.json",
    "./dist/zui.css": "./dist/zui.css",
    "./dist/zui.compat.css": "./dist/zui.compat.css",
    "./dist/zui.dom.js": "./dist/zui.dom.js",
    "./dist/zui.dom.carousel-gl.js": "./dist/zui.dom.carousel-gl.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@zuccadev-labs/zuix-zicon": "workspace:^",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@zuccadev-labs/zuix-tokens": "workspace:^"
  },
  "devDependencies": {
    "@zuccadev-labs/zuix-zicon": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "manifest.json",
    "html.json",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/zui.dom.js"
  ],
