{
  "$comment": "Contrato común a todas las marcas. `{nombre}` se resuelve a var(--z-nombre). Una marca puede sobrescribir cualquier clave de `scale`, `semantic` o `component` desde su archivo en brands/.",
  "scale": {
    "space-0": "0",
    "space-0-5": "2px",
    "space-1": "4px",
    "space-1-5": "6px",
    "space-2": "8px",
    "space-2-5": "10px",
    "space-3": "12px",
    "space-3-5": "14px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-7": "28px",
    "space-8": "32px",
    "space-9": "36px",
    "space-10": "40px",
    "space-12": "48px",
    "space-14": "56px",
    "space-16": "64px",
    "space-20": "80px",

    "radius-xs": "6px",
    "radius-sm": "10px",
    "radius-md": "14px",
    "radius-lg": "16px",
    "radius-xl": "20px",
    "radius-panel": "24px",
    "radius-full": "999px",

    "text-fine": "0.6875rem",
    "text-caption": "0.75rem",
    "text-small": "0.8125rem",
    "text-body": "0.875rem",
    "text-code": "0.8125rem",
    "text-reading": "1rem",
    "text-lead": "clamp(1.125rem, 1.05rem + 0.3vw, 1.25rem)",
    "text-title": "1rem",
    "text-heading": "1.125rem",
    "text-heading-lg": "1.25rem",
    "text-display-sm": "clamp(1.375rem, 1.18rem + 0.55vw, 1.625rem)",
    "text-display": "clamp(1.75rem, 1.45rem + 0.9vw, 2.25rem)",
    "text-display-lg": "clamp(2.25rem, 1.6rem + 2.2vw, 3rem)",
    "text-hero": "clamp(2.25rem, 1.4rem + 3.6vw, 4.5rem)",

    "weight-regular": "400",
    "weight-medium": "500",
    "weight-semibold": "600",
    "weight-bold": "700",
    "weight-display": "600",

    "leading-tight": "1.1",
    "leading-snug": "1.25",
    "leading-normal": "1.5",
    "leading-relaxed": "1.625",
    "leading-ui": "1.43",
    "leading-code": "1.7",

    "tracking-display": "-0.03em",
    "tracking-tight": "-0.02em",
    "tracking-snug": "-0.01em",
    "tracking-normal": "0",
    "tracking-wide": "0.06em",

    "duration-press": "90ms",
    "duration-fast": "150ms",
    "duration-normal": "200ms",
    "duration-slow": "320ms",
    "ease-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
    "ease-emphasized": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-exit": "cubic-bezier(0.4, 0, 1, 1)",
    "ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",

    "layer-below": "-1",
    "layer-raised": "1",
    "layer-sticky": "20",
    "layer-overlay": "50",
    "layer-menu": "60",
    "layer-dialog": "80",
    "layer-popover": "85",
    "layer-tooltip": "88",
    "layer-toast": "90",
    "layer-top": "100",

    "rail-width": "58px",
    "sidebar-width": "224px",
    "inspector-width": "400px",
    "header-height": "60px",
    "touch-target": "0px",
    "shell-gap": "12px",
    "stage-pad-x": "32px",
    "stage-pad-y": "24px",
    "content-max": "1200px",
    "prose-max": "72ch",
    "container-sm": "640px",
    "container-md": "768px",
    "container-lg": "1024px",
    "container-xl": "1280px",
    "container-gutter": "clamp(16px, 4cqi, 40px)",
    "size-compact": "0px",
    "size-medium": "600px",
    "size-expanded": "840px",
    "size-large": "1200px",
    "size-xlarge": "1600px",

    "docs-navbar-height": "48px",
    "docs-sidebar-width": "248px",
    "docs-rail-width": "224px",
    "docs-article-max": "768px",
    "docs-gutter": "clamp(12px, 3.6vw, 56px)",
    "docs-gap": "24px"
  },
  "semantic": {
    "accent-hover": "color-mix(in srgb, {accent} 86%, white)",
    "accent-solid": "{accent}",
    "accent-solid-hover": "color-mix(in srgb, {accent-solid} 88%, black)",
    "accent-text": "color-mix(in srgb, {accent} 48%, {fg})",
    "accent-soft": "color-mix(in srgb, {accent} 18%, transparent)",
    "accent-ring": "{accent-text}",
    "success-text": "color-mix(in srgb, {success} 58%, {fg})",
    "warning-text": "color-mix(in srgb, {warning} 62%, {fg})",
    "danger-text": "color-mix(in srgb, {danger} 44%, {fg})",
    "info-text": "color-mix(in srgb, {info} 58%, {fg})",
    "success-solid": "color-mix(in srgb, {success} 68%, black)",
    "warning-solid": "color-mix(in srgb, {warning} 64%, black)",
    "danger-solid": "color-mix(in srgb, {danger} 86%, black)",
    "info-solid": "color-mix(in srgb, {info} 68%, black)",
    "success-soft": "color-mix(in srgb, {success} 18%, transparent)",
    "warning-soft": "color-mix(in srgb, {warning} 18%, transparent)",
    "danger-soft": "color-mix(in srgb, {danger} 20%, transparent)",
    "info-soft": "color-mix(in srgb, {info} 18%, transparent)",
    "fg-prose": "color-mix(in srgb, {fg} 88%, transparent)",
    "glass-blur": "36px",
    "glass-blur-elevated": "48px",
    "glass-saturate": "180%"
  },
  "coarse": {
    "touch-target": "40px",
    "timegrid-hour": "64px"
  },
  "component": {
    "focus-width": "2px",
    "focus-offset": "2px",
    "focus-ring": "0 0 0 2px {canvas}, 0 0 0 4px {accent-ring}",
    "scrim": "rgba(0, 0, 0, 0.5)",

    "control-height-xs": "max(24px, {touch-target})",
    "control-height-sm": "max(28px, {touch-target})",
    "control-height-md": "max(34px, {touch-target})",
    "control-height-lg": "40px",
    "control-height-xl": "48px",
    "control-radius-sm": "calc({radius-sm} - 2px)",
    "control-radius": "{radius-sm}",
    "control-radius-lg": "calc({radius-sm} + 2px)",
    "control-radius-xl": "{radius-md}",
    "control-bg": "{inset}",
    "control-bg-hover": "color-mix(in srgb, {fg} 8%, {control-bg})",
    "control-border": "color-mix(in srgb, {fg} 50%, transparent)",
    "control-border-hover": "{fg-muted}",
    "field-radius-multiline": "{control-radius-lg}",
    "item-radius": "{radius-sm}",

    "button-radius": "{control-radius}",
    "button-primary-bg": "{accent-solid}",
    "button-primary-bg-hover": "{accent-solid-hover}",
    "button-primary-fg": "{fg-on-accent}",

    "card-bg": "{surface}",
    "card-border": "{line}",
    "card-radius": "{radius-xl}",
    "card-shadow": "{shadow-sm}",

    "panel-radius": "{radius-panel}",
    "popup-bg": "{overlay}",
    "popup-blur": "{glass-blur-elevated}",
    "popup-radius": "{radius-lg}",
    "popup-shadow": "{shadow-lg}",
    "tooltip-bg": "{overlay}",
    "glass-rim": "linear-gradient(180deg, {glass-highlight}, transparent 38%)",

    "reading-bg": "color-mix(in srgb, {surface-solid} 94%, transparent)",
    "code-bg": "{inset}",
    "code-bar-bg": "{surface}",
    "code-radius": "{radius-xl}",

    "calendar-cell": "36px",
    "calendar-cell-radius": "{control-radius}",
    "calendar-range-bg": "{accent-soft}",
    "calendar-today-ring": "{accent}",

    "calendar-color-1": "{info}",
    "calendar-color-2": "{success}",
    "calendar-color-3": "{warning}",
    "calendar-color-4": "{danger}",
    "calendar-color-5": "color-mix(in srgb, {info} 52%, {danger})",
    "calendar-color-6": "color-mix(in srgb, {info} 50%, {success})",
    "event-tint": "20%",
    "event-radius": "{radius-xs}",
    "event-bar-width": "3px",
    "event-fg": "{fg}",
    "event-fg-muted": "{fg-muted}",
    "event-solid-1": "color-mix(in srgb, {calendar-color-1} 58%, black)",
    "event-solid-2": "color-mix(in srgb, {calendar-color-2} 58%, black)",
    "event-solid-3": "color-mix(in srgb, {calendar-color-3} 58%, black)",
    "event-solid-4": "color-mix(in srgb, {calendar-color-4} 58%, black)",
    "event-solid-5": "color-mix(in srgb, {calendar-color-5} 58%, black)",
    "event-solid-6": "color-mix(in srgb, {calendar-color-6} 58%, black)",
    "timegrid-hour": "48px",
    "timegrid-gutter": "56px",
    "calendar-now": "{accent}",
    "calendar-now-label-bg": "{accent-solid}",
    "calendar-weekend-bg": "color-mix(in srgb, {fg} 2.5%, transparent)",
    "calendar-drop-bg": "color-mix(in srgb, {accent} 7%, transparent)",

    "perpetual-side-bg": "color-mix(in srgb, {accent-solid} 88%, black)",
    "heatmap-hue": "{accent-text}",
    "heatmap-0": "{surface-2}",
    "heatmap-1": "color-mix(in srgb, {heatmap-hue} 34%, {surface-solid})",
    "heatmap-2": "color-mix(in srgb, {heatmap-hue} 56%, {surface-solid})",
    "heatmap-3": "color-mix(in srgb, {heatmap-hue} 78%, {surface-solid})",
    "heatmap-4": "{heatmap-hue}",

    "chart-1": "color-mix(in srgb, {info} 80%, {surface-solid})",
    "chart-2": "color-mix(in srgb, {warning} 90%, {surface-solid})",
    "chart-3": "color-mix(in srgb, {danger} 90%, {fg})",
    "chart-4": "color-mix(in srgb, {success} 70%, {fg})",
    "chart-5": "color-mix(in srgb, color-mix(in srgb, {info} 55%, {danger}) 80%, {fg})",
    "chart-6": "color-mix(in srgb, {warning} 60%, {danger})",
    "chart-7": "color-mix(in srgb, color-mix(in srgb, {info} 35%, {danger}) 70%, {fg})",
    "chart-8": "color-mix(in srgb, {danger} 60%, {warning})",
    "colorpicker-spectrum": "#ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000",
    "colorpicker-white": "#ffffff",
    "colorpicker-black": "#000000",
    "qrcode-dark": "#000000",
    "qrcode-light": "#ffffff",
    "chart-grid": "{line}",
    "chart-baseline": "{line-strong}",
    "chart-height": "240px",
    "chart-bar-max": "28px",
    "chart-bar-radius": "{radius-xs}",
    "chart-area-opacity": "0.16",
    "chart-line-width": "2px"
  },
  "required": [
    "accent",
    "fg",
    "fg-muted",
    "fg-subtle",
    "fg-on-accent",
    "canvas",
    "canvas-gradient",
    "canvas-fg",
    "canvas-fg-muted",
    "glass-bg",
    "glass-border",
    "glass-highlight",
    "glass-specular",
    "glass-shadow",
    "surface",
    "surface-2",
    "surface-3",
    "surface-solid",
    "overlay",
    "inset",
    "line",
    "line-strong",
    "row-hover",
    "success",
    "warning",
    "danger",
    "info",
    "shadow-sm",
    "shadow-md",
    "shadow-lg"
  ],
  "moreContrast": {
    "focus-width": "3px",
    "fg-prose": "{fg}",
    "fg-muted": "{fg}",
    "fg-subtle": "color-mix(in srgb, {fg} 82%, transparent)",
    "canvas-fg-muted": "{canvas-fg}",
    "line": "color-mix(in srgb, {fg} 45%, transparent)",
    "line-strong": "color-mix(in srgb, {fg} 70%, transparent)",
    "glass-border": "color-mix(in srgb, {fg} 45%, transparent)",
    "glass-bg": "{surface-solid}",
    "overlay": "{surface-solid}",
    "reading-bg": "{surface-solid}",
    "canvas-gradient": "none",
    "control-border": "{fg}",
    "control-border-hover": "{fg}"
  },
  "forcedColors": {
    "canvas-gradient": "none",
    "glass-specular": "transparent"
  },
  "contrast": {
    "$comment": "Lo que mide src/validate.mjs. `surfaces`: fondos sobre los que se pinta contenido (las translúcidas se componen sobre canvas y los extremos de su degradado). `text`: tokens de texto que deben llegar a 4.5:1 sobre todas ellas. `canvasText`: texto que va directamente sobre canvas. `pairs`: pares con fondo propio. `nonText`: 3:1 frente a la superficie (WCAG 1.4.11). `ignore`: usos de las hojas que no son un par real, con su motivo.",
    "surfaces": {
      "glass": { "over": "canvas", "layers": ["glass-bg"] },
      "card-on-glass": { "over": "canvas", "layers": ["glass-bg", "card-bg"] },
      "overlay": { "over": "canvas", "layers": ["overlay"] },
      "solid": { "layers": ["surface-solid"] },
      "card-on-solid": { "layers": ["surface-solid", "card-bg"] },
      "reading": { "over": "canvas", "layers": ["reading-bg"] },
      "code-on-reading": { "over": "canvas", "layers": ["reading-bg", "code-bg"] },
      "control-on-glass": { "over": "canvas", "layers": ["glass-bg", "control-bg"] }
    },
    "text": ["fg", "fg-prose", "fg-muted", "fg-subtle", "accent-text", "success-text", "warning-text", "danger-text", "info-text"],
    "canvasText": ["canvas-fg", "canvas-fg-muted"],
    "pairs": [
      { "fg": "fg-on-accent", "bg": "accent-solid", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "accent-solid-hover", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "success-solid", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "warning-solid", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "danger-solid", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "info-solid", "min": 4.5 },
      { "fg": "accent-text", "bg": "accent-soft", "min": 4.5 },
      { "fg": "success-text", "bg": "success-soft", "min": 4.5 },
      { "fg": "warning-text", "bg": "warning-soft", "min": 4.5 },
      { "fg": "danger-text", "bg": "danger-soft", "min": 4.5 },
      { "fg": "info-text", "bg": "info-soft", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "event-solid-1", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "event-solid-2", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "event-solid-3", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "event-solid-4", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "event-solid-5", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "event-solid-6", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "calendar-now-label-bg", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "perpetual-side-bg", "min": 4.5 },
      { "fg": "perpetual-side-bg", "bg": "fg-on-accent", "min": 4.5 }
    ],
    "nonText": [
      "control-border",
      "control-border-hover",
      "accent-ring",
      "accent",
      "success",
      "warning",
      "danger",
      "info",
      "calendar-color-1",
      "calendar-color-2",
      "calendar-color-3",
      "calendar-color-4",
      "calendar-color-5",
      "calendar-color-6",
      "calendar-now",
      "heatmap-hue",
      "heatmap-3",
      "heatmap-4",
      "chart-1",
      "chart-2",
      "chart-3",
      "chart-4",
      "chart-5",
      "chart-6",
      "chart-7",
      "chart-8"
    ],
    "ignore": [
      {
        "selector": ".z-check__box",
        "reason": "El color es el de la marca de verificación, que solo se ve con la casilla marcada (fondo accent-solid)."
      },
      {
        "selector": ".z-event[data-selected]",
        "reason": "Fondo event-solid-N del calendario del evento (variable local); el par fg-on-accent / event-solid-1…6 se mide en pairs."
      },
      {
        "selector": ".z-event[data-dragging]",
        "reason": "Como el seleccionado: fg-on-accent sobre event-solid-N, medido en pairs."
      }
    ]
  }
}
