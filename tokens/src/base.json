{
  "$comment": "Contrato común a todas las marcas. `{nombre}` se resuelve a var(--z-nombre). Una marca puede sobrescribir cualquier clave de `scale`, `semantic` o `component` desde su archivo en brands/.",
  "scale": {
    "space-0": "0",
    "space-1": "4px",
    "space-1-5": "6px",
    "space-2": "8px",
    "space-2-5": "10px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-10": "40px",
    "space-12": "48px",
    "space-16": "64px",
    "space-20": "80px",

    "radius-xs": "6px",
    "radius-sm": "10px",
    "radius-md": "14px",
    "radius-lg": "16px",
    "radius-xl": "22px",
    "radius-panel": "24px",
    "radius-full": "999px",

    "text-fine": "10px",
    "text-caption": "11px",
    "text-small": "12px",
    "text-body": "13.5px",
    "text-title": "14px",
    "text-heading": "15px",
    "text-heading-lg": "18px",
    "text-display-sm": "20px",
    "text-display": "28px",
    "text-display-lg": "40px",
    "text-hero": "clamp(2.25rem, 1.4rem + 3.6vw, 4.5rem)",

    "weight-regular": "400",
    "weight-medium": "500",
    "weight-semibold": "600",
    "weight-bold": "700",

    "leading-tight": "1.15",
    "leading-snug": "1.3",
    "leading-normal": "1.5",
    "leading-relaxed": "1.7",

    "tracking-tight": "-0.02em",
    "tracking-normal": "0",
    "tracking-wide": "0.06em",

    "duration-fast": "120ms",
    "duration-normal": "200ms",
    "duration-slow": "320ms",
    "ease-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
    "ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",

    "layer-below": "-1",
    "layer-raised": "1",
    "layer-sticky": "20",
    "layer-overlay": "50",
    "layer-menu": "60",
    "layer-dialog": "80",
    "layer-popover": "85",
    "layer-tooltip": "88",
    "layer-toast": "90",
    "layer-top": "100",

    "rail-width": "58px",
    "sidebar-width": "224px",
    "inspector-width": "400px",
    "header-height": "60px",
    "touch-target": "0px",
    "shell-gap": "12px",
    "stage-pad-x": "32px",
    "stage-pad-y": "24px",
    "content-max": "1200px",
    "prose-max": "72ch"
  },
  "semantic": {
    "accent-hover": "color-mix(in srgb, {accent} 86%, white)",
    "accent-solid": "{accent}",
    "accent-solid-hover": "color-mix(in srgb, {accent-solid} 88%, black)",
    "accent-text": "color-mix(in srgb, {accent} 48%, {fg})",
    "accent-soft": "color-mix(in srgb, {accent} 18%, transparent)",
    "accent-ring": "{accent-text}",
    "success-text": "color-mix(in srgb, {success} 58%, {fg})",
    "warning-text": "color-mix(in srgb, {warning} 62%, {fg})",
    "danger-text": "color-mix(in srgb, {danger} 44%, {fg})",
    "info-text": "color-mix(in srgb, {info} 58%, {fg})",
    "success-solid": "color-mix(in srgb, {success} 68%, black)",
    "warning-solid": "color-mix(in srgb, {warning} 64%, black)",
    "danger-solid": "color-mix(in srgb, {danger} 86%, black)",
    "info-solid": "color-mix(in srgb, {info} 68%, black)",
    "success-soft": "color-mix(in srgb, {success} 18%, transparent)",
    "warning-soft": "color-mix(in srgb, {warning} 18%, transparent)",
    "danger-soft": "color-mix(in srgb, {danger} 20%, transparent)",
    "info-soft": "color-mix(in srgb, {info} 18%, transparent)",
    "glass-blur": "36px",
    "glass-saturate": "160%"
  },
  "coarse": {
    "touch-target": "40px"
  },
  "component": {
    "focus-ring": "0 0 0 3px {accent-ring}",
    "scrim": "rgba(0, 0, 0, 0.5)",

    "control-height-sm": "max(30px, {touch-target})",
    "control-height-md": "max(36px, {touch-target})",
    "control-height-lg": "44px",
    "control-radius": "{radius-sm}",
    "control-bg": "{inset}",
    "control-border": "color-mix(in srgb, {fg} 50%, transparent)",
    "control-border-hover": "{fg-muted}",

    "button-radius": "{radius-full}",
    "button-primary-bg": "{accent-solid}",
    "button-primary-bg-hover": "{accent-solid-hover}",
    "button-primary-fg": "{fg-on-accent}",

    "card-bg": "{surface}",
    "card-border": "{line}",
    "card-radius": "{radius-lg}",
    "card-shadow": "{shadow-md}",

    "panel-radius": "{radius-panel}",
    "popup-bg": "{overlay}",
    "popup-radius": "{radius-md}",
    "tooltip-bg": "{overlay}",

    "reading-bg": "{surface-solid}",
    "code-bg": "{inset}"
  },
  "required": [
    "accent",
    "fg",
    "fg-muted",
    "fg-subtle",
    "fg-on-accent",
    "canvas",
    "canvas-gradient",
    "canvas-fg",
    "canvas-fg-muted",
    "glass-bg",
    "glass-border",
    "glass-highlight",
    "glass-specular",
    "glass-shadow",
    "surface",
    "surface-2",
    "surface-3",
    "surface-solid",
    "overlay",
    "inset",
    "line",
    "line-strong",
    "row-hover",
    "success",
    "warning",
    "danger",
    "info",
    "shadow-sm",
    "shadow-md",
    "shadow-lg"
  ],
  "moreContrast": {
    "fg-muted": "{fg}",
    "fg-subtle": "color-mix(in srgb, {fg} 82%, transparent)",
    "canvas-fg-muted": "{canvas-fg}",
    "line": "color-mix(in srgb, {fg} 45%, transparent)",
    "line-strong": "color-mix(in srgb, {fg} 70%, transparent)",
    "glass-border": "color-mix(in srgb, {fg} 45%, transparent)",
    "glass-bg": "{surface-solid}",
    "overlay": "{surface-solid}",
    "canvas-gradient": "none",
    "control-border": "{fg}",
    "control-border-hover": "{fg}"
  },
  "forcedColors": {
    "canvas-gradient": "none",
    "glass-specular": "transparent"
  },
  "contrast": {
    "$comment": "Lo que mide src/validate.mjs. `surfaces`: fondos sobre los que se pinta contenido (las translúcidas se componen sobre canvas y los extremos de su degradado). `text`: tokens de texto que deben llegar a 4.5:1 sobre todas ellas. `canvasText`: texto que va directamente sobre canvas. `pairs`: pares con fondo propio. `nonText`: 3:1 frente a la superficie (WCAG 1.4.11). `ignore`: usos de las hojas que no son un par real, con su motivo.",
    "surfaces": {
      "glass": { "over": "canvas", "layers": ["glass-bg"] },
      "card-on-glass": { "over": "canvas", "layers": ["glass-bg", "card-bg"] },
      "overlay": { "over": "canvas", "layers": ["overlay"] },
      "solid": { "layers": ["surface-solid"] },
      "card-on-solid": { "layers": ["surface-solid", "card-bg"] }
    },
    "text": ["fg", "fg-muted", "fg-subtle", "accent-text", "success-text", "warning-text", "danger-text", "info-text"],
    "canvasText": ["canvas-fg", "canvas-fg-muted"],
    "pairs": [
      { "fg": "fg-on-accent", "bg": "accent-solid", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "accent-solid-hover", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "success-solid", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "warning-solid", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "danger-solid", "min": 4.5 },
      { "fg": "fg-on-accent", "bg": "info-solid", "min": 4.5 },
      { "fg": "accent-text", "bg": "accent-soft", "min": 4.5 },
      { "fg": "success-text", "bg": "success-soft", "min": 4.5 },
      { "fg": "warning-text", "bg": "warning-soft", "min": 4.5 },
      { "fg": "danger-text", "bg": "danger-soft", "min": 4.5 },
      { "fg": "info-text", "bg": "info-soft", "min": 4.5 }
    ],
    "nonText": ["control-border", "control-border-hover", "accent-ring", "accent", "success", "warning", "danger", "info"],
    "ignore": [
      {
        "selector": ".z-check__box",
        "reason": "El color es el de la marca de verificación, que solo se ve con la casilla marcada (fondo accent-solid)."
      }
    ]
  }
}
