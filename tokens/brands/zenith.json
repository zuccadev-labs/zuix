      "warning": "#B45309",
      "warning-text": "color-mix(in srgb, {warning} 74%, {fg})",
      "danger": "#D11A5B",
      "danger-text": "color-mix(in srgb, {danger} 68%, {fg})",
      "info": "#1D4ED8",
      "info-text": "color-mix(in srgb, {info} 90%, {fg})",
      "shadow-sm": "0 1px 2px rgba(20, 22, 50, 0.10)",
      "shadow-md": "0 8px 24px -10px rgba(20, 22, 50, 0.22)",
