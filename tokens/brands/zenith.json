{
  "$schema": "../schema/brand.schema.json",
  "name": "zenith",
  "label": "Zenith",
  "primitives": {
    "indigo-200": "#B1BCFF",
    "indigo-300": "#8C9EFF",
    "indigo-500": "#4051B5",
    "indigo-600": "#35449B",
    "slate-950": "#12141C",
    "slate-900": "#1A1D29",
    "slate-50": "#F3F4FA",
    "ink": "#161822",
    "green-500": "#22C55E",
    "amber-500": "#F5A524",
    "pink-500": "#FF2D78",
    "sky-500": "#74B0FB"
  },
  "fonts": {
    "display": "\"Geist Variable\", \"Geist\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "sans": "\"Geist Variable\", \"Geist\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "themes": {
    "dark": {
