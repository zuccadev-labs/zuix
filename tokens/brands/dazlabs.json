      "canvas-fg": "#FFFFFF",
      "canvas-fg-muted": "rgba(255, 255, 255, 0.72)",
      "glass-bg": "rgba(24, 24, 30, 0.66)",
      "glass-border": "rgba(255, 255, 255, 0.10)",
      "glass-highlight": "rgba(255, 255, 255, 0.14)",
      "glass-specular": "rgba(255, 255, 255, 0.08)",
      "glass-shadow": "0 30px 80px -30px rgba(0, 0, 0, 0.75)",
      "surface": "rgba(255, 255, 255, 0.06)",
      "surface-2": "rgba(255, 255, 255, 0.09)",
      "surface-3": "rgba(255, 255, 255, 0.14)",
      "surface-solid": "{p.ink-800}",
      "overlay": "rgba(20, 20, 25, 0.94)",
      "inset": "rgba(0, 0, 0, 0.26)",
      "line": "rgba(255, 255, 255, 0.09)",
      "line-strong": "rgba(255, 255, 255, 0.18)",
      "row-hover": "rgba(255, 255, 255, 0.08)",
      "fg": "#FFFFFF",
      "fg-muted": "rgba(255, 255, 255, 0.70)",
      "fg-subtle": "rgba(255, 255, 255, 0.48)",
      "success": "{p.green-500}",
      "warning": "{p.amber-500}",
      "danger": "{p.pink-500}",
      "info": "{p.sky-500}",
      "shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.4)",
      "shadow-md": "0 8px 24px -10px rgba(0, 0, 0, 0.6)",
      "shadow-lg": "0 28px 70px -28px rgba(0, 0, 0, 0.75)"
