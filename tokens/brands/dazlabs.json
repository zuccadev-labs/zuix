      "row-hover": "rgba(11, 12, 13, 0.05)",
      "fg": "{p.ink-900}",
      "fg-muted": "rgba(11, 12, 13, 0.68)",
      "fg-subtle": "rgba(11, 12, 13, 0.50)",
      "success": "#15803D",
      "warning": "#B45309",
      "danger": "#D11A5B",
      "info": "#1D4ED8",
      "shadow-sm": "0 1px 2px rgba(20, 16, 40, 0.10)",
      "shadow-md": "0 8px 24px -10px rgba(20, 16, 40, 0.22)",
      "shadow-lg": "0 28px 70px -28px rgba(20, 16, 40, 0.35)"
    }
