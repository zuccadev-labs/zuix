{
  "$schema": "../schema/brand.schema.json",
  "name": "dazlabs",
  "label": "DAZLABS",
  "primitives": {
    "red-500": "#E74327",
    "red-600": "#C9361D",
    "lavender-300": "#B6ACD5",
    "lavender-500": "#8E80BE",
    "ink-900": "#0B0C0D",
    "ink-800": "#15161A",
    "ink-700": "#1E2026",
    "paper-50": "#F6F4FA",
    "white": "#FFFFFF",
    "green-500": "#22C55E",
    "amber-500": "#F5A524",
    "pink-500": "#FF2D78",
    "sky-500": "#74B0FB"
  },
  "fonts": {
    "display": "\"Poppins\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "sans": "\"DM Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "themes": {
    "dark": {
      "accent": "{p.red-500}",
      "accent-solid": "{p.red-600}",
      "fg-on-accent": "#FFFFFF",
      "canvas": "{p.ink-900}",
