    "light": {
      "accent": "{p.red-600}",
      "fg-on-accent": "#FFFFFF",
      "canvas": "{p.paper-50}",
      "canvas-gradient": "radial-gradient(900px 520px at 10% 12%, rgba(182, 172, 213, 0.55), transparent 60%), radial-gradient(760px 520px at 92% 86%, rgba(231, 67, 39, 0.16), transparent 60%), linear-gradient(160deg, #FBFAFD 0%, #F1EEF7 60%, #E9E5F2 100%)",
      "canvas-fg": "{p.ink-900}",
      "canvas-fg-muted": "rgba(11, 12, 13, 0.70)",
      "glass-bg": "rgba(255, 255, 255, 0.72)",
      "glass-border": "rgba(11, 12, 13, 0.10)",
      "glass-highlight": "rgba(255, 255, 255, 0.60)",
      "glass-specular": "rgba(255, 255, 255, 0.50)",
      "glass-shadow": "0 30px 80px -30px rgba(40, 30, 70, 0.30)",
      "surface": "rgba(11, 12, 13, 0.04)",
      "surface-2": "rgba(11, 12, 13, 0.065)",
      "surface-3": "rgba(11, 12, 13, 0.10)",
      "surface-solid": "#FFFFFF",
      "overlay": "rgba(252, 251, 254, 0.96)",
      "inset": "rgba(11, 12, 13, 0.05)",
      "line": "rgba(11, 12, 13, 0.09)",
