      "types": "./zui-dom-color.d.ts",
      "default": "./zui-dom-color.js"
    },
    "./zui/dom/media": {
      "types": "./zui-dom-media.d.ts",
      "default": "./zui-dom-media.js"
    },
    "./zui/dom/effects": {
      "types": "./zui-dom-effects.d.ts",
      "default": "./zui-dom-effects.js"
    },
    "./zui/dom/time": {
      "types": "./zui-dom-time.d.ts",
      "default": "./zui-dom-time.js"
    },
    "./zui/dom/terminal": {
      "types": "./zui-dom-terminal.d.ts",
      "default": "./zui-dom-terminal.js"
    },
    "./zui/dom/chat": {
      "types": "./zui-dom-chat.d.ts",
      "default": "./zui-dom-chat.js"
