{
  "name": "@zuccadev-labs/zuix",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "zuix",
    "design-system",
    "ui",
    "components",
    "design-tokens",
    "icons",
    "layouts",
    "liquid-glass",
    "react",
    "html",
    "css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuccadev-labs/zuix.git",
    "directory": "suite"
  },
  "homepage": "https://github.com/zuccadev-labs/zuix/tree/main/suite#readme",
  "bugs": {
    "url": "https://github.com/zuccadev-labs/zuix/issues"
  },
  "description": "Suite zuix completa en un paquete: tokens, iconos (zicon), componentes (zui) y layouts (zout). Estándar HTML + CSS + tokens con comportamiento sin framework y binding de React.",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./zui": {
      "types": "./zui.d.ts",
      "default": "./zui.js"
    },
    "./zui/dom": {
      "types": "./zui-dom.d.ts",
      "default": "./zui-dom.js"
    },
    "./zui/dom/core": {
      "types": "./zui-dom-core.d.ts",
      "default": "./zui-dom-core.js"
    },
    "./zui/dom/dates": {
      "types": "./zui-dom-dates.d.ts",
      "default": "./zui-dom-dates.js"
    },
    "./zui/dom/data": {
      "types": "./zui-dom-data.d.ts",
      "default": "./zui-dom-data.js"
    },
    "./zui/dom/content": {
      "types": "./zui-dom-content.d.ts",
      "default": "./zui-dom-content.js"
    },
